# =============================================================================
# 🦁 GRYFFINDOR OS — PRODUCTION ENVIRONMENT CONFIGURATION
# Copy this template to .env.local for local development.
# NEVER commit .env or .env.local to version control.
# In production, set these variables in your Vercel Project Settings.
# =============================================================================

# --- 1. SUPABASE DATABASE & AUTHENTICATION (PostgreSQL) ---
# Your Supabase Project API settings: https://app.supabase.com/project/_/settings/api
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# --- 2. RESEND TRANSACTIONAL EMAILS ---
# Resend API Key for automated quest, attendance & system notifications
# https://resend.com/api-keys
VITE_RESEND_API_KEY=re_your_api_key_here
VITE_NOTIFICATION_EMAIL_FROM=notifications@gryffindor.app
VITE_ADMIN_EMAIL=sreesh@gryffindor.app

# --- 3. CLOUDFLARE R2 PRIVATE OBJECT STORAGE ---
# Cloudflare R2 bucket for private documents, case study assets, & exports
# https://dash.cloudflare.com/?to=/:account/r2
VITE_R2_ACCOUNT_ID=your_cloudflare_account_id
VITE_R2_BUCKET_NAME=gryffindor-private-storage
VITE_R2_PUBLIC_URL=https://storage.gryffindor.app

# --- 4. PAYMENTS & COMMERCE (STRIPE / POLAR) [OPTIONAL] ---
# Enable only if client invoices or paid quests are processed
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...
VITE_POLAR_ORGANIZATION_ID=polar_org_...

# --- 5. APPLICATION RUNTIME & SECURITY ---
VITE_APP_ENV=production
VITE_APP_URL=https://gryffindor.vercel.app
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_AUDIT_LOGGING=true
